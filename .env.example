# SkyPulse Environment Configuration
APP_NAME=SkyPulse
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://localhost:8000,http://127.0.0.1:8000

# Upstream URLs
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=SkyPulseWeatherApp/1.0 (contact: support@skypulse.local)
IPWHOIS_URL=https://ipwho.is/
IPAPI_URL=https://ipapi.co/json/

# HTTP Client Settings
HTTP_TIMEOUT_SECONDS=8.0
HTTP_MAX_RETRIES=2
HTTP_BACKOFF_FACTOR=0.5

# Cache TTLs in seconds
CACHE_TTL_FORECAST=600
CACHE_TTL_AIR_QUALITY=1800
CACHE_TTL_STATE_OVERVIEW=900
CACHE_TTL_SEARCH=86400
CACHE_TTL_REVERSE_GEO=2592000
CACHE_TTL_IP_LOCATE=86400

# Rate Limiting
RATE_LIMIT_DEFAULT=60/minute

# Default Location Fallback
DEFAULT_CITY_NAME=New Delhi
DEFAULT_STATE_NAME=Delhi
DEFAULT_COUNTRY_NAME=India
DEFAULT_LATITUDE=28.6139
DEFAULT_LONGITUDE=77.2090

# Smart Insights Thresholds
THRESHOLD_HEAT_TEMP=38.0
THRESHOLD_COLD_TEMP=8.0
THRESHOLD_HIGH_UV=7.0
THRESHOLD_POOR_AQI=150
THRESHOLD_STRONG_GUST=45.0
THRESHOLD_HEAVY_RAIN=15.0
